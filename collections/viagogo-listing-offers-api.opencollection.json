        {
          "info": {
            "name": "Soft-delete an offer.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.viagogo.net/catalog/listingoffers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
