{
  "opencollection": "1.0.0",
  "info": {
    "name": "viagogo Catalog Listing Offers API",
    "version": "1.0.0.49"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
