            "method": "GET",
            "url": "https://api.viagogo.net/catalog/listingoffers/bidderbalance",
            "params": [
              {
                "name": "currencyCode",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
