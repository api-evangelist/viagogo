{
  "opencollection": "1.0.0",
  "info": {
    "name": "viagogo Inventory Listing Constraints API",
    "version": "2.249.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "ListingConstraints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List listing constraints for an event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.viagogo.net/v2/events/:eventId/listingconstraints",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List listing constraints for an event"
        },
        {
          "info": {
            "name": "Get listing constraints for a seller listing",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.viagogo.net/v2/sellerlistings/:listingId/constraints",
            "params": [
              {
                "name": "listingId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get listing constraints for a seller listing"
        },
        {
          "info": {
            "name": "Get listing constraints for a requested event",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.viagogo.net/v2/listingconstraints",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get listings constraints for an event requested by the current user."
        }
      ]
    }
  ],
  "bundled": true
}