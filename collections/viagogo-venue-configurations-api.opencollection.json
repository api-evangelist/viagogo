{
  "opencollection": "1.0.0",
  "info": {
    "name": "viagogo Catalog Venue Configurations API",
    "version": "1.0.0.49"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Venue Configurations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a venue configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.viagogo.net/catalog/venues/configurations/:configId",
            "params": [
              {
                "name": "configId",
                "value": "",
                "type": "path",
                "description": "The venue configuration identifier"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a venue configuration"
        }
      ]
    }
  ],
  "bundled": true
}