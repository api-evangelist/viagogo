{
  "opencollection": "1.0.0",
  "info": {
    "name": "viagogo Catalog Venues API",
    "version": "1.0.0.49"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Venues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List venues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.viagogo.net/catalog/venues",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Specifies which page of data to retrieve."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Set custom page sizes on response."
              },
              {
                "name": "updated_since",
                "value": "",
                "type": "query",
                "description": "Filters the response to only return items that have been updated since the given timestamp"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Determines the ordering of items. A comma-separated string containing `resource_version`."
              },
              {
                "name": "country_code",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Lists all venues on the viagogo platform. Use this endpoint to sync the entire viagogo Venue catalog with your application."
        },
        {
          "info": {
            "name": "Get a venue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.viagogo.net/catalog/venues/:venueId",
            "params": [
              {
                "name": "venueId",
                "value": "",
                "type": "path",
                "description": "The venue identifier"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.viagogo.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a venue"
        }
      ]
    }
  ],
  "bundled": true
}